# Copy this file to .jira.env and fill in your own credentials:
#
#   cp .jira.env.example .jira.env
#
# .jira.env is git-ignored — never commit a real API token.
#
# NobleSee task management lives in Jira:
#   https://fanchuanster.atlassian.net/jira/software/projects/SCRUM/summary
#
# Load into a shell with:
#   set -a; . ./.jira.env; set +a
#
# Then e.g.:
#   curl -s -u "$JIRA_EMAIL:$JIRA_API_TOKEN" \
#     "$JIRA_API_BASE/rest/api/3/search/jql?jql=project=$JIRA_PROJECT_KEY"
#
# IMPORTANT: scoped API tokens (the current Atlassian default) do NOT work
# against https://<site>.atlassian.net/rest/... — those calls come back 401,
# or 200 with empty results as if you were anonymous. Send REST calls to
# JIRA_API_BASE instead. Find your cloud id with:
#   curl -s https://<site>.atlassian.net/_edge/tenant_info

JIRA_BASE_URL=https://fanchuanster.atlassian.net
JIRA_CLOUD_ID=
JIRA_API_BASE=https://api.atlassian.com/ex/jira/<cloud-id>
# Project keys are uppercase A-Z/0-9 only (no underscores, no lowercase).
JIRA_PROJECT_KEY=NR
JIRA_PROJECT_ID=10000
# Atlassian account email (the token's owner).
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
