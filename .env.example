# Copy this file to .env before running `docker compose up`
# (docker compose reads .env automatically — no extra flags needed).
#
#   cp .env.example .env

# --- Database ---
MYSQL_DATABASE=nobleread
MYSQL_USER=nobleread
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- WordPress site ---
# Use localhost for a purely local dev loop. To reach the site from other
# machines on the network, set this to http://<host-ip-or-hostname>:8090
# instead — WordPress bakes this into siteurl/home, and links/assets will
# be broken for remote visitors if it's left as localhost.
WORDPRESS_URL=http://localhost:8090
WORDPRESS_TITLE=NobleRead
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-admin-password
WORDPRESS_ADMIN_EMAIL=admin@nobelread.com

# --- NobleRead plugin ---
# Per-user cap on the number of book PARTS downloadable within a rolling
# 24h window — a volume limit, not a network/bandwidth control. Also
# editable later in wp-admin under Settings > NobleRead.
NR_DOWNLOAD_LIMIT_PER_DAY=5

# --- R2 storage (book artifacts: DOCX/EPUB/PDF — see includes/storage.php
# and CLAUDE.md section 14) ---
# Leave the three CLOUDFLARE_S3_* vars blank for local dev without an R2
# account: storage.php falls back to WordPress's local uploads whenever
# they're unset, so the site works either way. Create an R2 API token
# scoped to a single bucket (Cloudflare dashboard > R2 > Manage API
# tokens) for the access key/secret; the endpoint is
# https://<account_id>.r2.cloudflarestorage.com.
CLOUDFLARE_S3_ENDPOINTS=
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET_ACCESS_KEY=
NR_R2_BUCKET=nobleread
# Cloudflare account-level API token (bucket create/list/manage via the
# Cloudflare API) — not consumed by the app itself, which talks to R2
# only through its S3-compatible API above. Keep it around for
# operator/admin use (creating buckets, rotating the S3 token, etc.).
CLOUDFLARE_API_TOKEN=

# --- Google sign-up (see includes/social-login.php) ---
# Leave blank for local dev without a Google account: the "Continue with
# Google" button on /sign-up/ only appears once both are set, same
# fallback pattern as R2 above. To get these: Google Cloud Console >
# APIs & Services > Credentials > Create OAuth client ID (Web
# application), then add this EXACT URL as an Authorized redirect URI
# (must match WORDPRESS_URL above):
#   {WORDPRESS_URL}/auth/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
