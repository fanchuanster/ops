# Copy this file to .env before running `docker compose up`
# (docker compose reads .env automatically — no extra flags needed).
#
#   cp .env.example .env

# --- Database ---
MYSQL_DATABASE=nobleread
MYSQL_USER=nobleread
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- WordPress site ---
WORDPRESS_URL=http://localhost:8090
WORDPRESS_TITLE=NobleRead
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=change-me-admin-password
WORDPRESS_ADMIN_EMAIL=admin@nobelread.com

# --- NobleRead plugin ---
# Per-user cap on the number of book PARTS downloadable within a rolling
# 24h window — a volume limit, not a network/bandwidth control. Also
# editable later in wp-admin under Settings > NobleRead.
NR_DOWNLOAD_LIMIT_PER_DAY=5
