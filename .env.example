# Copy this file to .env before running `docker compose up`
# (docker compose reads .env automatically — no extra flags needed).
#
#   cp .env.example .env

# --- Application database (PostgreSQL 18) ---
POSTGRES_DB=noblesee
POSTGRES_USER=noblesee
POSTGRES_PASSWORD=change-me-db-password

# --- Payload ---
# REQUIRED, and there is deliberately no default. Sessions are signed
# with it, so a value that changes on restart silently logs everyone
# out, and a shared value committed anywhere would let someone forge a
# session. Generate your own:
#
#   openssl rand -hex 32
PAYLOAD_SECRET=

# The site's own public origin. Behind the Cloudflare Tunnel the
# container only ever sees plain HTTP on its own port and cannot infer
# the public name, so Payload needs it told — it scopes CSRF and CORS
# as well as building absolute URLs. Use http://localhost:8093 for a
# purely local dev loop.
PUBLIC_SITE_URL=https://noblesee.com

# --- Object storage: Cloudflare R2, over the S3 API ---
# Book artifacts (DOCX/EPUB/PDF) and cover images. Leave these blank for
# local dev without an R2 account — Payload falls back to local disk and
# the stack still runs. Create an R2 API token scoped to a single bucket
# (Cloudflare dashboard > R2 > Manage API tokens); the endpoint is
# https://<account_id>.r2.cloudflarestorage.com.
#
# R2 rather than AWS S3 because the domain, DNS and tunnel already live
# on Cloudflare and R2 has no egress fees. It is S3-compatible, so
# moving to S3 later is a config swap, not a rewrite.
CLOUDFLARE_S3_ENDPOINTS=
CLOUDFLARE_S3_ACCESS_KEY_ID=
CLOUDFLARE_S3_SECRET_ACCESS_KEY=
R2_BUCKET=noblesee

# Cloudflare account-level API token (bucket create/list/manage via the
# Cloudflare API) — not consumed by the app itself, which talks to R2
# only through its S3-compatible API above. Keep it for operator use
# (creating buckets, rotating the S3 token, DNS changes).
CLOUDFLARE_API_TOKEN=

# --- Cloudflare Tunnel ---
# Issued by Cloudflare Zero Trust > Networks > Tunnels. Leave unset and
# the `cloudflared` service simply won't start, so local-only
# development is unaffected. The public hostname -> service mapping is
# configured in that dashboard, not here.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Google sign-in ---
# The OAuth client itself carries over unchanged; the integration
# against Payload auth is not built yet (NR-30).
# Authorized redirect URI: {PUBLIC_SITE_URL}/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
