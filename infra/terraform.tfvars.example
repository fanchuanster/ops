# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Find these with:
#   curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
#     https://api.cloudflare.com/client/v4/accounts
#   curl -s -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
#     https://api.cloudflare.com/client/v4/zones

account_id = ""
zone_id    = ""

domain      = "noblesee.com"
environment = "production"

# Location hint for R2 and D1. A hint, not a guarantee.
r2_location = "APAC"

# Leave false until `wrangler deploy` has created the Worker; see the
# ordering note at the top of worker.tf.
worker_deployed = false

# Set false if the token lacks the zone "Single Redirect" permission;
# the rest of the configuration still applies cleanly without it.
manage_redirect_ruleset = true

# DNS records proving NobleSee may send mail as the domain, for
# Send-to-Kindle. Paste in what Resend shows after verifying
# noblesee.com; leave empty to run without Kindle delivery.
#
# email_dns_records = [
#   { name = "send",              type = "MX",  content = "feedback-smtp.eu-west-1.amazonses.com", priority = 10 },
#   { name = "send",              type = "TXT", content = "v=spf1 include:amazonses.com ~all" },
#   { name = "resend._domainkey", type = "TXT", content = "p=MIGfMA0GCSq..." },
# ]
email_dns_records = []

# --- Google Cloud, for Document AI OCR ---------------------------------
#
# Authenticate separately; the provider reads the environment:
#   gcloud auth application-default login
#
# Defaults to the existing project; override only for a separate one.
# gcp_project = "gen-lang-client-0021728111"

# Bucket names are globally unique across all of Google Cloud, so this
# needs a suffix nobody else has taken.
documentai_bucket = "noblesee-conversion-0021728111"

# Default to Singapore, the nearest Document AI region to the APAC R2
# bucket and the Tokyo D1. Change them together or batch jobs cross a
# region twice.
# documentai_location = "asia-southeast1"
# gcs_location        = "ASIA-SOUTHEAST1"
