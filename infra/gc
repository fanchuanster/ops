#!/usr/bin/env bash
#
# Runs the Google Cloud CLI in a container.
#
# Same reasoning as apps/web/cf: this host has no gcloud and installing
# one is a bigger commitment than borrowing an image. Terraform's google
# provider only needs the credentials file gcloud writes, so the CLI
# itself never has to exist outside this wrapper.
#
#   ./gc gcloud auth application-default login --no-launch-browser
#   ./gc gcloud config set project my-project-first-296702
#   ./gc gcloud projects describe my-project-first-296702
#
# Credentials persist in .gcloud-home/ beside this script, which is
# gitignored. Terraform reads them through GOOGLE_APPLICATION_CREDENTIALS
# — see providers.tf — so nothing needs to be copied anywhere.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE="google/cloud-sdk:slim"

mkdir -p "$HERE/.gcloud-home"

# A pseudo-terminal only when there is one, so this works from a shell
# and from a script alike. The device-code login needs stdin either way.
TTY=(-i)
[ -t 0 ] && TTY=(-it)

# Runs as the invoking user, not root.
#
# This matters more than it looks: a credential written by root inside
# the container is root-owned on the host, and Terraform runs as you —
# so it cannot read the very file it was told to use. Owning them also
# keeps them yours rather than readable by anything running as root.
#
# CLOUDSDK_CONFIG rather than the default ~/.config/gcloud, because a
# non-root uid cannot write to /root. HOME is somewhere writable for the
# same reason.
exec docker run --rm "${TTY[@]}" \
    -v "$HERE/.gcloud-home:/gcloud" \
    -v "$(cd "$HERE/.." && pwd):/repo" \
    -w /repo/infra \
    -e CLOUDSDK_CONFIG=/gcloud \
    -e HOME=/tmp \
    -u "$(id -u):$(id -g)" \
    "$IMAGE" "$@"
