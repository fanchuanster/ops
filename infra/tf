#!/usr/bin/env bash
#
# Terraform wrapper.
#
# Loads the repo's .env so CLOUDFLARE_API_TOKEN reaches the provider,
# and fails with a usable message when it is missing — the provider's
# own error for an absent token is an unexplained authentication
# failure, which is a poor first experience.
#
#   ./infra/tf plan
#   ./infra/tf apply
#
# Same subcommands and flags as terraform. Bare `terraform -chdir=infra`
# works too, provided you export CLOUDFLARE_API_TOKEN yourself.
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(dirname "$HERE")"

if [ ! -f "$REPO/.env" ]; then
    echo "infra/tf: $REPO/.env not found — copy .env.example and fill it in." >&2
    exit 1
fi

# shellcheck disable=SC1091
set -a
. "$REPO/.env"
set +a

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
    echo "infra/tf: CLOUDFLARE_API_TOKEN is empty in .env." >&2
    echo "          Create a token with the scopes listed in infra/README.md." >&2
    exit 1
fi

# The S3 backend on R2 — see backend.tf, which is a partial config.
#
# These arrive through the environment rather than through backend.tf so
# that neither the account id (in the endpoint) nor the R2 keys are
# committed. The backend reads AWS_* names because it is the AWS S3
# backend; nothing here talks to AWS.
if [ -z "${CLOUDFLARE_S3_ACCESS_KEY_ID:-}" ] || [ -z "${CLOUDFLARE_S3_SECRET_ACCESS_KEY:-}" ] \
    || [ -z "${CLOUDFLARE_S3_ENDPOINTS:-}" ]; then
    echo "infra/tf: R2 state backend needs CLOUDFLARE_S3_ACCESS_KEY_ID," >&2
    echo "          CLOUDFLARE_S3_SECRET_ACCESS_KEY and CLOUDFLARE_S3_ENDPOINTS" >&2
    echo "          in .env. Create an R2 API token in the Cloudflare dashboard." >&2
    exit 1
fi

export AWS_ACCESS_KEY_ID="$CLOUDFLARE_S3_ACCESS_KEY_ID"
export AWS_SECRET_ACCESS_KEY="$CLOUDFLARE_S3_SECRET_ACCESS_KEY"
export AWS_ENDPOINT_URL_S3="$CLOUDFLARE_S3_ENDPOINTS"
# A stray AWS profile or session token in the ambient environment would
# be picked up ahead of these and sent to R2, which fails confusingly.
unset AWS_PROFILE AWS_SESSION_TOKEN AWS_DEFAULT_PROFILE 2>/dev/null || true

exec terraform -chdir="$HERE" "$@"
