{
  "name": "@noblesee/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "//payload": "NEXT_RUNTIME=nodejs lets the Payload CLI resolve the D1 and R2 bindings through wrangler's local Miniflare, the same way next dev does.",
    "payload": "NEXT_RUNTIME=nodejs payload",
    "seed": "NEXT_RUNTIME=nodejs payload run src/seed/seed.ts",
    "//seed:remote": "Seeds the LIVE catalog. npm run seed always targets local D1 by design; see scripts/seed-remote.ts. Idempotent \u2014 matched on slug.",
    "seed:remote": "SEED_TARGET=remote NEXT_RUNTIME=nodejs payload run scripts/seed-remote.ts",
    "//create-admin": "Bootstraps an administrator. Payload only shows its create-first-user screen while the users table is empty, so this is the way in once any reader exists.",
    "create-admin": "NEXT_RUNTIME=nodejs payload run scripts/create-admin.ts",
    "create-admin:remote": "ADMIN_TARGET=remote NEXT_RUNTIME=nodejs payload run scripts/create-admin.ts",
    "generate:types": "NEXT_RUNTIME=nodejs payload generate:types",
    "generate:importmap": "NEXT_RUNTIME=nodejs payload generate:importmap",
    "migrate:create": "NEXT_RUNTIME=nodejs payload migrate:create",
    "migrate": "NEXT_RUNTIME=nodejs payload migrate",
    "//migrate:remote": "Applies pending migrations to the LIVE database. npm run migrate always targets local D1 by design; see scripts/migrate-remote.ts. Migrate before deploying the Worker.",
    "migrate:remote": "MIGRATE_TARGET=remote NEXT_RUNTIME=nodejs payload run scripts/migrate-remote.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundary": "sh scripts/check-domain-boundary.sh",
    "verify": "npm run generate:types && npm run check:boundary && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@payloadcms/db-d1-sqlite": "^3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-r2": "^3.88.0",
    "epubjs": "^0.3.93",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
