.cf-home/
.open-next/
.wrangler/
# cloudflare-env.d.ts is generated by `./cf npm run cf-typegen` but committed:
# it is what makes env.DB and env.ARTIFACTS type-check, so a checkout
# must not need the toolchain to run before tsc will pass.

# Local Worker secrets for `wrangler dev`. Never committed; the
# production value is set with `wrangler secret put PAYLOAD_SECRET`.
.dev.vars
.r2-mirror-keys
