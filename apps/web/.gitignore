# Build and tool state
.cf-home/
.open-next/
.wrangler/

# Local Worker secrets for `wrangler dev`. Never committed; the
# production value is set with `wrangler secret put PAYLOAD_SECRET`.
.dev.vars

# Scratch files from promoting local D1 to remote and mirroring R2.
.r2-mirror-keys
.d1-*.sql

# Note: cloudflare-env.d.ts is generated by `./cf npm run cf-typegen`
# but deliberately COMMITTED — it is what makes env.DB and env.ARTIFACTS
# type-check, so a fresh checkout must not need the toolchain to run
# before tsc will pass.
