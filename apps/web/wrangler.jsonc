/**
 * Worker configuration for the NobleSee web application.
 *
 * The bindings here must match `terraform output wrangler_bindings` —
 * Terraform owns the D1 database and the R2 bucket, this file only
 * attaches them. If the two disagree the deploy succeeds and the app
 * fails at runtime, so treat the Terraform output as the source of
 * truth and copy from it rather than editing values here by hand.
 *
 * Deliberately absent: any secret. PAYLOAD_SECRET signs sessions and is
 * set with `wrangler secret put PAYLOAD_SECRET`, which keeps it out of
 * the repository and out of the deploy log. R2 and D1 need no
 * credentials at all — a binding is a capability handed to this Worker
 * alone, which is why the port drops the long-lived S3 access keys the
 * container needed.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noblesee",
  "main": ".open-next/worker.js",

  // Recent enough for the Node compatibility surface Payload and the
  // Next server rely on.
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "noblesee",
      "database_id": "23b37124-5024-4c1b-a23a-082cfa11cd03"
    }
  ],

  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "noblesee"
    }
  ],

  "vars": {
    // Payload scopes CSRF and CORS to this origin and builds absolute
    // URLs from it, so it must be the real public name, not a guess.
    "NEXT_PUBLIC_SERVER_URL": "https://noblesee.com",

    // Document AI, from `terraform output`. None of these is a secret:
    // the processor name and bucket are identifiers, and reaching either
    // needs GOOGLE_SERVICE_ACCOUNT_KEY, which is.
    //
    // The processor is a full resource name because it already carries
    // the project and the location — splitting it into three vars would
    // create three ways for them to disagree.
    "DOCUMENT_AI_PROCESSOR": "projects/gen-lang-client-0021728111/locations/asia-southeast1/processors/1fdee9b756a6e620",

    // Duplicated out of the resource name on purpose: it selects the API
    // *endpoint* (asia-southeast1-documentai.googleapis.com), which is a
    // different use than naming the processor.
    "DOCUMENT_AI_LOCATION": "asia-southeast1",

    "DOCUMENT_AI_BUCKET": "noblesee-conversion-0021728111"
  }
}
